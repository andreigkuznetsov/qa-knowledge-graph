            "evidenceType": "OBSERVED"
          }
        ],
        "metadata": {},
        "operation": {
          "code": "REGISTER_USER",
          "domain": "BookShop authentication",
          "businessOutcome": "A valid new user is persisted and represented in the successful API response"
        }
      },
      {
        "id": "BR-REG-001",
        "type": "BUSINESS_RULE",
        "name": "Registration data must be valid",
        "description": "Username, password, role, phone, and email must satisfy the declared request constraints.",
        "status": "CONFIRMED",
        "tags": ["VALIDATION"],
        "sourceReferences": [
          {
            "sourceId": "SRC-BOOKSHOP-REPOSITORY",
            "location": {"type": "OTHER", "value": "RegisterRequest, PasswordValidator, and NoEmojiNoXssValidator"},
            "text": "Registration field constraints are enforced by Bean Validation and custom validators.",
            "confidence": 1,
            "evidenceType": "OBSERVED"
          }
        ],
        "metadata": {},
        "rule": {
          "code": "VALID_REGISTRATION_DATA",
          "ruleType": "VALIDATION_RULE",
          "text": "Registration data must satisfy the username, password, role, phone, and email constraints.",
          "expression": null
        }
      },
      {
        "id": "BR-REG-002",
        "type": "BUSINESS_RULE",
        "name": "Username must be unique",
        "description": "Registration is rejected when the submitted username already exists.",
        "status": "CONFIRMED",
        "tags": ["UNIQUENESS"],
        "sourceReferences": [
          {
            "sourceId": "SRC-BOOKSHOP-REPOSITORY",
            "location": {"type": "OTHER", "value": "AuthService.register: AppUserRepository.existsByUsername"},
            "text": "AuthService throws UserAlreadyExistsException for an existing username.",
            "confidence": 1,
            "evidenceType": "OBSERVED"
          }
        ],
        "metadata": {},
        "rule": {
          "code": "UNIQUE_USERNAME",
          "ruleType": "BUSINESS_INVARIANT",
          "text": "The submitted username must not already exist.",
          "expression": "!userRepository.existsByUsername(request.username)"
        }
      },
      {
        "id": "BR-REG-003",
        "type": "BUSINESS_RULE",
        "name": "Administrator count is limited to three",
        "description": "An ADMIN registration is rejected when three administrators already exist.",
        "status": "CONFIRMED",
        "tags": ["ADMIN", "LIMIT"],
        "sourceReferences": [
          {
            "sourceId": "SRC-BOOKSHOP-REPOSITORY",
            "location": {"type": "OTHER", "value": "AuthService.register and AuthRegisterValidationIT.shouldNotAllowMoreThanThreeAdmins"},
            "text": "AuthService rejects an ADMIN registration when countByRole(ADMIN) is at least three.",
            "confidence": 1,
            "evidenceType": "OBSERVED"
          }
        ],
        "metadata": {},
        "rule": {
          "code": "MAX_THREE_ADMINS",
          "ruleType": "BUSINESS_INVARIANT",
          "text": "The system may contain no more than three administrators.",
          "expression": "request.role != ADMIN || userRepository.countByRole(ADMIN) < 3"
        }
      },
      {
        "id": "BR-REG-004",
        "type": "BUSINESS_RULE",
        "name": "Initialize a protected novice account",
        "description": "The password is encoded and a new account is initialized with zero loyalty points and NOVICE loyalty level.",
        "status": "CONFIRMED",
        "tags": ["PASSWORD", "LOYALTY", "INITIALIZATION"],
        "sourceReferences": [
          {
            "sourceId": "SRC-BOOKSHOP-REPOSITORY",
            "location": {"type": "OTHER", "value": "AuthService.register and AppUser"},
            "text": "AuthService encodes the password and builds AppUser with loyaltyPoints 0 and LoyaltyLevel.NOVICE.",
            "confidence": 1,
            "evidenceType": "OBSERVED"
          }
        ],
        "metadata": {},
        "rule": {
          "code": "INITIALIZE_PROTECTED_NOVICE_ACCOUNT",
          "ruleType": "POSTCONDITION",
          "text": "A persisted new user has an encoded password, zero loyalty points, and NOVICE loyalty level.",
          "expression": null
        }
      },
